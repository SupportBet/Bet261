    <ul>
	<?php
    // On sélectionne uniquement les tutoriels de type 'video'
    $tutos = $bdd->query("SELECT * FROM tutoriels WHERE type = 'video' ORDER BY id DESC");
    
    while ($tuto = $tutos->fetch()) {
        $videoPath = htmlspecialchars($tuto['fichier_path']);
        $titre = htmlspecialchars($tuto['titre']);
        
        // Au clic, on appelle la fonction playVideo() avec le chemin du fichier
        echo "<li>
                <a href='javascript:void(0)' onclick=\"playVideo('$videoPath')\">
                    ▶ " . $titre . "
                </a>
              </li>";
    }
    ?>
