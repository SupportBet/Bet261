   <main>
     <?php
$videos = $bdd->query('SELECT * FROM tutoriels WHERE type = "video" ORDER BY id DESC');
while ($tuto = $videos->fetch()) {
    echo '<div class="video-card">';
    echo '<h3>' . htmlspecialchars($tuto['titre']) . '</h3>';
    
    // Code ultra-simple et propre
    echo '<video width="600" controls>
            <source src="' . htmlspecialchars($tuto['fichier_path']) . '" type="video/mp4">
            Votre navigateur ne supporte pas la vidéo.
          </video>';
          
    echo '</div>';
}
?>
<h2 id="javascript:void(0)"></h2>
    <div class="section-docs">
       <?php
       // On récupère tout ce qui n'est pas 'video'
       $docs = $bdd->query("SELECT * FROM tutoriels WHERE type != 'video'");
       while ($doc = $docs->fetch()) {
           echo '<div class="doc-card">';
           // Icône ou lien selon l'extension
           echo '</div>';
       }
       ?>
      </div>
    </main>
<script>
    // Ouverture manuelle
    function openTuto() {
        document.getElementById("sidebar-tuto").classList.add("active");
    }
    function openDoc() {
        document.getElementById("sidebar-documents").classList.add("active");
    }

    // Fermeture manuelle
    function closeAll() {
        document.getElementById("sidebar-tuto").classList.remove("active");
        document.getElementById("sidebar-documents").classList.remove("active");
    }
</script>
<script>
function playVideo(videoPath) {
    var videoPlayer = document.getElementById("main-video");
    // Change la source de la vidéo
    videoPlayer.src = videoPath;
    // Recharge et lance la vidéo
    videoPlayer.load();
    videoPlayer.play();
}
</script>
</body>
</html>
